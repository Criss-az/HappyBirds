{
  "name": "happybirds",
  "private": true,
  "version": "0.1.0",
  "description": "Reconocimiento de aves de Bolivia por sus vocalizaciones: interfaz web para cargar o grabar un audio y ver la especie identificada. Proyecto del Grupo 7 de Machine Learning (CNN, aprendizaje supervisado, Deep Learning).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=18.18"
  }
}
